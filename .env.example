# Copy this file to .env and fill in your secrets.
# .env is gitignored. Never commit secrets.

# --- MCPs ---
# GitHub MCP — issues, PRs, file ops
GITHUB_TOKEN=

# Notion MCP — read specs, write notes
NOTION_API_KEY=

# Linear MCP — ticket creation and triage
LINEAR_API_KEY=

# PostHog MCP — analytics queries, feature flag flips
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.posthog.com

# Supabase MCP — DB inspection
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site (V2 only — leave empty for V1) ---
# Resend (changelog email list)
RESEND_API_KEY=
# GitHub OAuth (one-click fork)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Analytics ---
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
